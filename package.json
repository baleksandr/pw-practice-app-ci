  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4201",
    "pageObjects-chrome": "playwright test usePageObjects.spec.ts --project=chromium",
    "pageObjects-chrome:allure": "playwright test usePageObjects.spec.ts --project=chromium && npm run allure:generate && npm run allure:open",
    "pageObjects-firefox": "playwright test usePageObjects.spec.ts --project=firefox",
    "pageObjects-firefox:allure": "playwright test usePageObjects.spec.ts --project=firefox && npm run allure:generate && npm run allure:open",
    "pageObjects-all": "npm run pageObjects-chrome && npm run pageObjects-firefox",
    "test": "playwright test",
    "test:allure": "playwright test && allure generate allure-results --clean && allure open",
    "allure:generate": "allure generate allure-results --clean",
    "allure:open": "allure open"
  },
  "overrides": {
    "stylus": "github:stylus/stylus#0.54.5"
  },
